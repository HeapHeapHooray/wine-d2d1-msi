diff --git a/dlls/wbemprox/service.c b/dlls/wbemprox/service.c
index a0988d83b54..aa0d446be6c 100644
--- a/dlls/wbemprox/service.c
+++ b/dlls/wbemprox/service.c
@@ -51,6 +51,96 @@ static UINT map_error( DWORD error )
     return 8;
 }
 
+HRESULT service_create( IWbemClassObject *obj, IWbemContext *context, IWbemClassObject *in, IWbemClassObject **out )
+{
+    VARIANT name, displayname, pathname, startmode, retval;
+    IWbemClassObject *sig = NULL, *out_params = NULL;
+    SC_HANDLE manager, service;
+    DWORD start_type = SERVICE_DEMAND_START;
+    UINT error = 0;
+    HRESULT hr;
+
+    TRACE("%p, %p, %p, %p\n", obj, context, in, out);
+
+    VariantInit( &name );
+    VariantInit( &displayname );
+    VariantInit( &pathname );
+    VariantInit( &startmode );
+
+    if (in)
+    {
+        IWbemClassObject_Get( in, L"Name", 0, &name, NULL, NULL );
+        IWbemClassObject_Get( in, L"DisplayName", 0, &displayname, NULL, NULL );
+        IWbemClassObject_Get( in, L"PathName", 0, &pathname, NULL, NULL );
+        IWbemClassObject_Get( in, L"StartMode", 0, &startmode, NULL, NULL );
+    }
+
+    if (V_VT(&startmode) == VT_BSTR && V_BSTR(&startmode))
+    {
+        if (!wcsicmp( V_BSTR(&startmode), L"Automatic" ) || !wcsicmp( V_BSTR(&startmode), L"Auto" ))
+            start_type = SERVICE_AUTO_START;
+        else if (!wcsicmp( V_BSTR(&startmode), L"Disabled" ))
+            start_type = SERVICE_DISABLED;
+    }
+
+    hr = create_signature( WBEMPROX_NAMESPACE_CIMV2, L"Win32_Service", L"Create", PARAM_OUT, &sig );
+    if (hr != S_OK) goto done;
+
+    if (out)
+    {
+        hr = IWbemClassObject_SpawnInstance( sig, 0, &out_params );
+        if (hr != S_OK) goto done;
+    }
+
+    if (V_VT(&name) != VT_BSTR || !V_BSTR(&name) || V_VT(&pathname) != VT_BSTR || !V_BSTR(&pathname))
+    {
+        error = 2; /* Invalid parameter */
+    }
+    else
+    {
+        manager = OpenSCManagerW( NULL, NULL, SC_MANAGER_CREATE_SERVICE );
+        if (manager)
+        {
+            service = CreateServiceW( manager, V_BSTR(&name),
+                                       (V_VT(&displayname) == VT_BSTR) ? V_BSTR(&displayname) : V_BSTR(&name),
+                                       SERVICE_ALL_ACCESS, SERVICE_WIN32_OWN_PROCESS,
+                                       start_type, SERVICE_ERROR_NORMAL, V_BSTR(&pathname),
+                                       NULL, NULL, NULL, NULL, NULL );
+            if (service)
+            {
+                CloseServiceHandle( service );
+                error = 0; /* Success */
+            }
+            else
+            {
+                DWORD err = GetLastError();
+                if (err == ERROR_SERVICE_EXISTS) error = 0;
+                else error = map_error( err );
+            }
+            CloseServiceHandle( manager );
+        }
+        else error = map_error( GetLastError() );
+    }
+
+    set_variant( VT_UI4, error, NULL, &retval );
+    if (out_params)
+        hr = IWbemClassObject_Put( out_params, L"ReturnValue", 0, &retval, CIM_UINT32 );
+
+done:
+    VariantClear( &name );
+    VariantClear( &displayname );
+    VariantClear( &pathname );
+    VariantClear( &startmode );
+    if (sig) IWbemClassObject_Release( sig );
+    if (hr == S_OK && out)
+    {
+        *out = out_params;
+        IWbemClassObject_AddRef( out_params );
+    }
+    if (out_params) IWbemClassObject_Release( out_params );
+    return hr;
+}
+
 static HRESULT control_service( const WCHAR *name, DWORD control, VARIANT *retval )
 {
     SC_HANDLE manager, service = NULL;
