     hr = parse_path( object_path, &path );
     if (hr != S_OK) return hr;
 
+    if (!path->filter)
+    {
+        free_path( path );
+        return create_class_object( ns, object_path, NULL, 0, NULL, obj );
+    }
+
     hr = create_instance_enum( ns, path, &iter );
     if (hr != S_OK)
     {
