@@ -806,7 +952,7 @@ static HRESULT create_signature_columns_and_data( IEnumWbemClassObject *iter, UI
 
         hr = IWbemClassObject_Get( param, L"Type", 0, &val, NULL, NULL );
         if (hr != S_OK) goto error;
