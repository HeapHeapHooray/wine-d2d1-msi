+        V_BOOL( var ) = record->fields[index].u.ival ? VARIANT_TRUE : VARIANT_FALSE;
+        break;
+    case CIM_UINT8:
+        V_UI1( var ) = record->fields[index].u.ival;
+        break;
+    case CIM_SINT8:
+        V_I1( var ) = record->fields[index].u.ival;
+        break;
+    case CIM_UINT16:
+        V_UI2( var ) = record->fields[index].u.ival;
+        break;
+    case CIM_SINT16:
+        V_I2( var ) = record->fields[index].u.ival;
+        break;
     case CIM_STRING:
     case CIM_DATETIME:
     case CIM_REFERENCE:
@@ -378,8 +393,14 @@ static HRESULT record_get_value( const struct record *record, UINT index, VARIAN
     case CIM_UINT32:
         V_UI4( var ) = record->fields[index].u.ival;
         break;
+    case CIM_SINT64:
+        V_I8( var ) = record->fields[index].u.ival;
+        break;
+    case CIM_UINT64:
+        V_UI8( var ) = record->fields[index].u.ival;
+        break;
     default:
-        FIXME("unhandled type %u\n", record->fields[index].type);
+        FIXME("unhandled type %u\n", record->fields[index].type & COL_TYPE_MASK);
         return WBEM_E_INVALID_PARAMETER;
     }
     V_VT( var ) = vartype;
@@ -395,50 +416,145 @@ static HRESULT WINAPI class_object_Get(
     LONG *plFlavor )
 {
     struct class_object *co = impl_from_IWbemClassObject( iface );
-    struct enum_class_object *ec = impl_from_IEnumWbemClassObject( co->iter );
+    struct enum_class_object *ec;
 
     TRACE( "%p, %s, %#lx, %p, %p, %p\n", iface, debugstr_w(wszName), lFlags, pVal, pType, plFlavor );
 
+    if (!wcsicmp( wszName, L"__CLASS" ) || !wcsicmp( wszName, L"__PATH" ) || !wcsicmp( wszName, L"__RELPATH" ))
+    {
+        if (pVal)
+        {
+            V_VT( pVal ) = VT_BSTR;
+            V_BSTR( pVal ) = SysAllocString( co->name ? co->name : (co->record ? co->record->table->name : L"") );
+        }
+        if (pType) *pType = CIM_STRING;
+        if (plFlavor) *plFlavor = WBEM_FLAVOR_ORIGIN_SYSTEM;
+        return S_OK;
+    }
+    if (!wcsicmp( wszName, L"__GENUS" ))
+    {
+        if (pVal)
+        {
+            V_VT( pVal ) = VT_I4;
+            V_I4( pVal ) = co->record ? WBEM_GENUS_INSTANCE : WBEM_GENUS_CLASS;
+        }
+        if (pType) *pType = CIM_SINT32;
+        if (plFlavor) *plFlavor = WBEM_FLAVOR_ORIGIN_SYSTEM;
+        return S_OK;
+    }
+    if (!wcsicmp( wszName, L"__SERVER" ))
+    {
+        if (pVal)
+        {
+            V_VT( pVal ) = VT_BSTR;
+            V_BSTR( pVal ) = SysAllocString( L"." );
+        }
+        if (pType) *pType = CIM_STRING;
+        if (plFlavor) *plFlavor = WBEM_FLAVOR_ORIGIN_SYSTEM;
+        return S_OK;
+    }
+    if (!wcsicmp( wszName, L"__NAMESPACE" ))
+    {
+        if (pVal)
+        {
+            V_VT( pVal ) = VT_BSTR;
+            V_BSTR( pVal ) = SysAllocString( L"root\\cimv2" );
+        }
+        if (pType) *pType = CIM_STRING;
+        if (plFlavor) *plFlavor = WBEM_FLAVOR_ORIGIN_SYSTEM;
+        return S_OK;
+    }
+
     if (co->record)
     {
         UINT index;
         HRESULT hr;
 
+        if (!wcsicmp( wszName, L"__PROPERTY_COUNT" ))
+        {
+            if (pVal)
+            {
+                V_VT( pVal ) = VT_I4;
+                V_I4( pVal ) = co->record->table->num_cols;
+            }
+            if (pType) *pType = CIM_SINT32;
+            if (plFlavor) *plFlavor = WBEM_FLAVOR_ORIGIN_SYSTEM;
+            return S_OK;
+        }
+
         if ((hr = get_column_index( co->record->table, wszName, &index )) != S_OK) return hr;
         return record_get_value( co->record, index, pVal, pType );
     }
-    return get_propval( ec->query->view, co->index, wszName, pVal, pType, plFlavor );
+
+    if (co->iter)
+    {
+        ec = impl_from_IEnumWbemClassObject( co->iter );
+        return get_propval( ec->query->view, co->index, wszName, pVal, pType, plFlavor );
+    }
+
+    if (co->name)
+    {
+        struct table *table = create_table( co->ns, co->name );
+        UINT index;
+
+        if (table)
+        {
+            HRESULT hr = get_column_index( table, wszName, &index );
+            if (hr == S_OK)
+            {
+                if (pType) *pType = table->columns[index].type & COL_TYPE_MASK;
+                if (pVal) V_VT( pVal ) = VT_NULL;
+                if (plFlavor) *plFlavor = WBEM_FLAVOR_ORIGIN_PROPAGATED;
+                release_table( table );
+                return S_OK;
+            }
+            release_table( table );
+        }
+    }
+
+    return WBEM_E_NOT_FOUND;
 }
 
 static HRESULT record_set_value( struct record *record, UINT index, VARIANT *var )
 {
     LONGLONG val;
-    CIMTYPE type;
+    CIMTYPE type, target_type = record->fields[index].type & COL_TYPE_MASK;
     HRESULT hr;
 
+    if (!var || V_VT( var ) == VT_NULL)
+    {
+        record->fields[index].u.ival = 0;
+        return S_OK;
+    }
+
     if ((hr = to_longlong( var, &val, &type )) != S_OK) return hr;
-    if (type != record->fields[index].type) return WBEM_E_TYPE_MISMATCH;
 
-    if (type & CIM_FLAG_ARRAY)
+    if (target_type & CIM_FLAG_ARRAY)
     {
         record->fields[index].u.aval = (struct array *)(INT_PTR)val;
         return S_OK;
     }
-    switch (type)
+
+    switch (target_type)
     {
     case CIM_STRING:
     case CIM_DATETIME:
     case CIM_REFERENCE:
         record->fields[index].u.sval = (WCHAR *)(INT_PTR)val;
         return S_OK;
+    case CIM_BOOLEAN:
+    case CIM_UINT8:
+    case CIM_SINT8:
     case CIM_SINT16:
     case CIM_UINT16:
     case CIM_SINT32:
     case CIM_UINT32:
+    case CIM_SINT64:
+    case CIM_UINT64:
         record->fields[index].u.ival = val;
         return S_OK;
     default:
-        FIXME( "unhandled type %lu\n", type );
+        FIXME( "unhandled type %lu\n", target_type );
         break;
     }
     return WBEM_E_INVALID_PARAMETER;
@@ -494,21 +610,22 @@ static HRESULT WINAPI class_object_GetNames(
     if (!pNames)
         return WBEM_E_INVALID_PARAMETER;
 
-    /* Combination used in a handful of broken apps */
-    if (lFlags == (WBEM_FLAG_ALWAYS | WBEM_MASK_CONDITION_ORIGIN))
-        lFlags = WBEM_FLAG_ALWAYS;
+    lFlags &= ~WBEM_MASK_CONDITION_ORIGIN;
+    lFlags &= ~0x30;
 
     if (lFlags && (lFlags != WBEM_FLAG_ALWAYS &&
         lFlags != WBEM_FLAG_NONSYSTEM_ONLY &&
         lFlags != WBEM_FLAG_SYSTEM_ONLY))
     {
-        FIXME( "flags %#lx not supported\n", lFlags );
-        return E_NOTIMPL;
+        TRACE( "ignoring unsupported flags %#lx\n", lFlags );
     }
 
     if (wszQualifierName || pQualifierVal)
         FIXME("qualifier not supported\n");
 
+    if (co->record)
+        return get_table_properties( co->record->table, lFlags, pNames );
+
     return get_properties( ec->query->view, co->index, lFlags, pNames );
 }
 
@@ -703,23 +820,52 @@ static HRESULT WINAPI class_object_SpawnInstance(
     IWbemClassObject **ppNewInstance )
 {
     struct class_object *co = impl_from_IWbemClassObject( iface );
-    struct enum_class_object *ec = impl_from_IEnumWbemClassObject( co->iter );
-    struct table *table = get_view_table( ec->query->view, co->index );
-    IEnumWbemClassObject *iter;
+    struct table *table;
     struct record *record;
     HRESULT hr;
 
     TRACE( "%p, %#lx, %p\n", iface, lFlags, ppNewInstance );
 
-    if (!(record = create_record( table ))) return E_OUTOFMEMORY;
-    if (FAILED(hr = IEnumWbemClassObject_Clone( co->iter, &iter )))
+    if (!ppNewInstance) return WBEM_E_INVALID_PARAMETER;
+
+    if (co->iter)
     {
-        destroy_record( record );
+        struct enum_class_object *ec = impl_from_IEnumWbemClassObject( co->iter );
+        IEnumWbemClassObject *iter;
+
+        table = get_view_table( ec->query->view, co->index );
+        if (!(record = create_record( table ))) return E_OUTOFMEMORY;
+        if (FAILED(hr = IEnumWbemClassObject_Clone( co->iter, &iter )))
+        {
+            destroy_record( record );
+            return hr;
+        }
+        hr = create_class_object( co->ns, co->name, iter, 0, record, ppNewInstance );
+        IEnumWbemClassObject_Release( iter );
         return hr;
     }
-    hr = create_class_object( co->ns, co->name, iter, 0, record, ppNewInstance );
-    IEnumWbemClassObject_Release( iter );
-    return hr;
+
+    if (co->record)
+    {
+        if (!(record = create_record( co->record->table ))) return E_OUTOFMEMORY;
+        return create_class_object( co->ns, co->name, NULL, 0, record, ppNewInstance );
+    }
+
+    if (co->name)
+    {
+        table = create_table( co->ns, co->name );
+        if (!table) return WBEM_E_NOT_FOUND;
+        if (!(record = create_record( table )))
+        {
+            release_table( table );
+            return E_OUTOFMEMORY;
+        }
+        hr = create_class_object( co->ns, co->name, NULL, 0, record, ppNewInstance );
+        release_table( table );
+        return hr;
+    }
+
+    return WBEM_E_FAILED;
 }
 
