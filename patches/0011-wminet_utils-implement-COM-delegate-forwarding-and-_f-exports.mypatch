+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "ole2.h"
+#include "wbemcli.h"
+#include "objidl.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wminet_utils);
+
+HRESULT WINAPI CloneEnumWbemClassObject(IEnumWbemClassObject **ppEnum, LONG lFlags, LONG lTimeout,
+        IEnumWbemClassObject *pEnum, LPCWSTR wszUser, LPCWSTR wszPassword, LPCWSTR wszAuthority)
+{
+    TRACE("%p %lx %lx %p %s %s %s\n", ppEnum, lFlags, lTimeout, pEnum, debugstr_w(wszUser),
+            debugstr_w(wszPassword), debugstr_w(wszAuthority));
+
+    return IEnumWbemClassObject_Clone(pEnum, ppEnum);
+}
+
+HRESULT WINAPI ConnectServerWmi(LPCWSTR wszNetworkResource, LPCWSTR wszUser, LPCWSTR wszPassword,
+        LPCWSTR wszLocale, LONG lSecurityFlags, LPCWSTR wszAuthority, IWbemContext *pCtx,
+        IWbemServices **ppWorkingNamespace, LONG lFlags, LONG lTimeout)
+{
+    IWbemLocator *locator;
+    HRESULT hr;
+
+    TRACE("%s %s %s %s %lx %s %p %p %lx %lx\n", debugstr_w(wszNetworkResource), debugstr_w(wszUser),
+            debugstr_w(wszPassword), debugstr_w(wszLocale), lSecurityFlags, debugstr_w(wszAuthority),
+            pCtx, ppWorkingNamespace, lFlags, lTimeout);
+
+    hr = CoCreateInstance(&CLSID_WbemLocator, NULL, CLSCTX_INPROC_SERVER, &IID_IWbemLocator, (void **)&locator);
+    if (FAILED(hr))
+        return hr;
+
+    hr = IWbemLocator_ConnectServer(locator, (BSTR)wszNetworkResource, (BSTR)wszUser, (BSTR)wszPassword,
+            (BSTR)wszLocale, lSecurityFlags, (BSTR)wszAuthority, pCtx, ppWorkingNamespace);
+
+    IWbemLocator_Release(locator);
+
+    return hr;
+}
+
+HRESULT WINAPI CreateInstanceEnumWmi(LPCWSTR wszFilter, LONG lFlags, IWbemContext *pCtx,
+        IEnumWbemClassObject **ppEnum, LONG lTimeOut, LONG lSecurityFlags, LPCWSTR wszAuthority,
+        LPCWSTR wszUser, LPCWSTR wszPassword, LPCWSTR wszLocale)
+{
+    TRACE("%s %lx %p %p %lx %lx %s %s %s %s\n", debugstr_w(wszFilter), lFlags, pCtx, ppEnum,
+            lTimeOut, lSecurityFlags, debugstr_w(wszAuthority), debugstr_w(wszUser), debugstr_w(wszPassword),
+            debugstr_w(wszLocale));
+
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI ExecQueryWmi(LPCWSTR wszQueryLanguage, LPCWSTR wszQuery, LONG lFlags, IWbemContext *pCtx,
+        IEnumWbemClassObject **ppEnum, LONG lTimeOut, LONG lSecurityFlags, LPCWSTR wszAuthority,
+        LPCWSTR wszUser, LPCWSTR wszPassword, LPCWSTR wszLocale)
+{
+    TRACE("%s %s %lx %p %p %lx %lx %s %s %s %s\n", debugstr_w(wszQueryLanguage), debugstr_w(wszQuery),
+            lFlags, pCtx, ppEnum, lTimeOut, lSecurityFlags, debugstr_w(wszAuthority), debugstr_w(wszUser),
+            debugstr_w(wszPassword), debugstr_w(wszLocale));
+
+    return E_NOTIMPL;
+}
+
+HRESULT WINAPI Get(int vFunc, IWbemClassObject *ptr, LPCWSTR wszName, LONG lFlags, VARIANT *pVal,
+        CIMTYPE *pvtType, LONG *plFlavor)
+{
+    TRACE("%i %p %s %lx %p %p %p\n", vFunc, ptr, debugstr_w(wszName), lFlags, pVal, pvtType, plFlavor);
+
+    return IWbemClassObject_Get(ptr, wszName, lFlags, pVal, pvtType, plFlavor);
+}
+
+HRESULT WINAPI GetMethod(int vFunc, IWbemClassObject *ptr, LPCWSTR wszName, LONG lFlags,
+    IWbemClassObject **ppInSignature, IWbemClassObject **ppOutSignature)
+{
+    TRACE("%i %p %s %lx %p %p\n", vFunc, ptr, debugstr_w(wszName), lFlags, ppInSignature, ppOutSignature);
+    return IWbemClassObject_GetMethod(ptr, wszName, lFlags, ppInSignature, ppOutSignature);
+}
+
+HRESULT WINAPI GetCurrentApartmentType(int vFunc, IComThreadingInfo *ptr, APTTYPE *aptType)
+{
+    TRACE("%i %p %p\n", vFunc, ptr, aptType);
+
+    return IComThreadingInfo_GetCurrentApartmentType(ptr, aptType);
+}
+
+HRESULT WINAPI Initialize(BOOLEAN bAllowIManagementObjectQI)
+{
+    TRACE("%i\n", bAllowIManagementObjectQI);
+    return S_OK;
+}
+
+HRESULT WINAPI GetNames(int vFunc, IWbemClassObject *ptr, LPCWSTR wszQualifierName, LONG lFlags,
+    VARIANT *pQualifierVal, SAFEARRAY **pNames)
+{
+    TRACE("%i %p %s %lx %p %p\n", vFunc, ptr, debugstr_w(wszQualifierName), lFlags, pQualifierVal, pNames);
+    return IWbemClassObject_GetNames(ptr, wszQualifierName, lFlags, pQualifierVal, pNames);
+}
+
+HRESULT WINAPI BeginEnumeration(int vFunc, IWbemClassObject *ptr, LONG lEnumFlags)
+{
+    TRACE("%i %p %lx\n", vFunc, ptr, lEnumFlags);
+    return IWbemClassObject_BeginEnumeration(ptr, lEnumFlags);
+}
+
+HRESULT WINAPI Next(int vFunc, IWbemClassObject *ptr, LONG lFlags, BSTR *strName, VARIANT *pVal,
+    CIMTYPE *pType, LONG *plFlavor)
+{
+    TRACE("%i %p %lx %p %p %p %p\n", vFunc, ptr, lFlags, strName, pVal, pType, plFlavor);
+    return IWbemClassObject_Next(ptr, lFlags, strName, pVal, pType, plFlavor);
+}
+
+HRESULT WINAPI EndEnumeration(int vFunc, IWbemClassObject *ptr)
+{
+    TRACE("%i %p\n", vFunc, ptr);
+    return IWbemClassObject_EndEnumeration(ptr);
+}
+
+HRESULT WINAPI SpawnInstance(int vFunc, IWbemClassObject *ptr, LONG lFlags, IWbemClassObject **ppNewInstance)
+{
+    TRACE("%i %p %lx %p\n", vFunc, ptr, lFlags, ppNewInstance);
+    return IWbemClassObject_SpawnInstance(ptr, lFlags, ppNewInstance);
+}
+
+HRESULT WINAPI Put(int vFunc, IWbemClassObject *ptr, LPCWSTR wszName, LONG lFlags, VARIANT *pVal, CIMTYPE Type)
+{
+    TRACE("%i %p %s %lx %p %lu\n", vFunc, ptr, debugstr_w(wszName), lFlags, pVal, Type);
+    return IWbemClassObject_Put(ptr, wszName, lFlags, pVal, Type);
+}
+
+HRESULT WINAPI GetQualifierSet(int vFunc, IWbemClassObject *ptr, IWbemQualifierSet **ppQualSet)
+{
+    TRACE("%i %p %p\n", vFunc, ptr, ppQualSet);
+    return IWbemClassObject_GetQualifierSet(ptr, ppQualSet);
+}
+
+HRESULT WINAPI QualifierSet_GetNames(int vFunc, IWbemQualifierSet *ptr, LPCWSTR wszQualifierName, LONG lFlags,
+    VARIANT *pQualifierVal, SAFEARRAY **pNames)
+{
+    TRACE("%i %p %s %lx %p %p\n", vFunc, ptr, debugstr_w(wszQualifierName), lFlags, pQualifierVal, pNames);
+    return IWbemQualifierSet_GetNames(ptr, lFlags, pNames);
+}
+
+HRESULT WINAPI QualifierSet_Get(int vFunc, IWbemQualifierSet *ptr, LPCWSTR wszName, LONG lFlags,
+    VARIANT *pVal, LONG *plFlavor)
+{
+    TRACE("%i %p %s %lx %p %p\n", vFunc, ptr, debugstr_w(wszName), lFlags, pVal, plFlavor);
+    return IWbemQualifierSet_Get(ptr, wszName, lFlags, pVal, plFlavor);
+}
+
+HRESULT WINAPI ResetSecurity(HANDLE hToken)
+{
+    return S_OK;
+}
+
+HRESULT WINAPI SetSecurity(BOOL *pNeedToReset, HANDLE *pHandle)
+{
+    if (pNeedToReset) *pNeedToReset = FALSE;
+    return S_OK;
+}
+
+HRESULT WINAPI BlessIWbemServices(void *pIUnknown, const WCHAR *user, void *password, const WCHAR *auth, int imp, int authn)
+{
+    return S_OK;
+}
+
+HRESULT WINAPI BlessIWbemServicesObject(void *pIUnknown, const WCHAR *user, void *password, const WCHAR *auth, int imp, int authn)
+{
+    return S_OK;
+}
+
+HRESULT WINAPI GetDemultiplexedStub(void *pUnk, BOOL local, void **ppUnk)
+{
+    if (ppUnk) *ppUnk = pUnk;
+    return S_OK;
+}
+
+HRESULT WINAPI VerifyClientKey(void)
+{
+    return S_OK;
+}
